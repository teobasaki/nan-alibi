{
  "name": "nan-alibi",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "npm run build && wrangler pages deploy dist",
    "cf:dev": "wrangler pages dev dist --live-reload",
    "typecheck:functions": "tsc -p functions --noEmit",
    "verify": "npm test && npm run typecheck:functions && npm run build",
    "audit:persona": "node scripts/persona-audit.mjs",
    "gen:pool": "node scripts/gen-pool.mjs",
    "review": "node scripts/review.mjs",
    "demo:seed": "node scripts/pick-demo-seed.mjs",
    "gen:chars": "node scripts/gen-characters.mjs",
    "opt:chars": "node scripts/opt-characters.mjs",
    "gen:portraits": "node scripts/gen-portraits.mjs",
    "pose:chars": "node scripts/pose-all.mjs",
    "gen:mv": "node scripts/multiview2char.mjs",
    "build:chars": "bash scripts/build-chars.sh",
    "add:face": "bash scripts/add-face.sh",
    "probe:seats": "node scripts/probe-seats.mjs",
    "probe:legs": "node scripts/probe-legs.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "@gltf-transform/cli": "^4.4.2",
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/extensions": "^4.4.2",
    "@types/node": "^26.1.2",
    "draco3dgltf": "^1.5.7",
    "happy-dom": "^15.11.7",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^2.1.9",
    "wrangler": "^4.118.0"
  },
  "dependencies": {
    "@types/three": "^0.185.4",
    "three": "^0.185.1"
  }
}
