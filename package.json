{
  "name": "nan-alibi",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "npm run build && wrangler pages deploy dist",
    "cf:dev": "wrangler pages dev dist --live-reload",
    "typecheck:functions": "tsc -p functions --noEmit",
    "verify": "npm test && npm run typecheck:functions && npm run build",
    "audit:persona": "node scripts/persona-audit.mjs",
    "review": "node scripts/review.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "@types/node": "^26.1.2",
    "happy-dom": "^15.11.7",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^2.1.9",
    "wrangler": "^4.118.0"
  }
}
